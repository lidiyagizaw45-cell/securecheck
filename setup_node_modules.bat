@echo off
setlocal EnableDelayedExpansion
title SecureCheck - Node Modules and Dependency Builder
color 0B

:: Always set working directory to script location
cd /d "%~dp0"

echo =====================================================================
echo    [SECURECHECK] NODE_MODULES PACKAGES AND DEPENDENCIES BUILDER
echo =====================================================================
echo.

:: 1. Auto-discover Node.js
where node >nul 2>&1
if %errorlevel% neq 0 (
    if exist "C:\Program Files\nodejs\node.exe" set "PATH=C:\Program Files\nodejs;!PATH!"
    if exist "C:\Program Files (x86)\nodejs\node.exe" set "PATH=C:\Program Files (x86)\nodejs;!PATH!"
    if exist "%LOCALAPPDATA%\Programs\node\node.exe" set "PATH=%LOCALAPPDATA%\Programs\node;!PATH!"
)

:: 2. Auto-discover Python
where python >nul 2>&1
if %errorlevel% neq 0 (
    if exist "C:\Python313\python.exe" set "PATH=C:\Python313;C:\Python313\Scripts;!PATH!"
    if exist "C:\Python312\python.exe" set "PATH=C:\Python312;C:\Python312\Scripts;!PATH!"
    if exist "C:\Python311\python.exe" set "PATH=C:\Python311;C:\Python311\Scripts;!PATH!"
    if exist "C:\Python310\python.exe" set "PATH=C:\Python310;C:\Python310\Scripts;!PATH!"
    if exist "%LOCALAPPDATA%\Programs\Python\Python313\python.exe" set "PATH=%LOCALAPPDATA%\Programs\Python\Python313;!PATH!"
    if exist "%LOCALAPPDATA%\Programs\Python\Python312\python.exe" set "PATH=%LOCALAPPDATA%\Programs\Python\Python312;!PATH!"
    if exist "%LOCALAPPDATA%\Programs\Python\Python311\python.exe" set "PATH=%LOCALAPPDATA%\Programs\Python\Python311;!PATH!"
)

:: 3. If setup_node_modules.py exists, run it
if exist "%~dp0setup_node_modules.py" (
    python setup_node_modules.py
    if !errorlevel! equ 0 (
        echo.
        pause
        exit /b 0
    )
    echo [WARNING] Python script encountered a warning. Running direct fallback...
)

:: 4. Direct Fallback Installation Pipeline (Runs even if setup_node_modules.py was not copied)
echo.
echo [ 15%%] Checking system runtime and packages...
python -m pip install --upgrade pip --quiet

echo.
echo [ 35%%] Installing Python backend dependencies from backend\requirements.txt...
python -m pip install -r backend\requirements.txt --quiet

echo.
echo [ 50%%] Initializing backend configuration and offline database folder...
if not exist "backend\.env" (
    if exist "backend\.env.example" (
        copy /y "backend\.env.example" "backend\.env" >nul
    ) else (
        (
            echo MONGODB_URI=mongodb://localhost:27017
            echo DATABASE_NAME=securecheck_db
            echo OPENROUTER_API_KEY=
            echo OPENROUTER_MODEL=openai/gpt-4o-mini
        ) > "backend\.env"
    )
    echo [OK] Backend .env file initialized.
)

if not exist "backend\data" mkdir "backend\data"

echo.
echo [ 75%%] Downloading and setting up frontend node_modules packages...
cd /d "%~dp0frontend"
call npm install --legacy-peer-deps
if !errorlevel! neq 0 (
    echo [WARNING] Retrying with --force...
    call npm install --force
)
cd /d "%~dp0"

:: 5. Create launcher if missing
echo.
echo [ 95%%] Verifying installation and configuring launcher...
if not exist "run_project.bat" (
    (
        echo @echo off
        echo setlocal EnableDelayedExpansion
        echo title SecureCheck - Launcher
        echo color 0A
        echo cd /d "%%~dp0"
        echo start "SecureCheck Backend API" cmd /k "cd /d "%%~dp0backend" && python -m uvicorn app.main:app --reload --port 8000"
        echo start "SecureCheck Frontend" cmd /k "cd /d "%%~dp0frontend" && npm run dev"
        echo timeout /t 4 /nobreak ^>nul
        echo start http://localhost:5173
        echo echo SecureCheck running at http://localhost:5173
    ) > "run_project.bat"
    echo [OK] Auto-created run_project.bat
)

echo.
echo =====================================================================
echo  [SUCCESS] 100%% - NODE_MODULES AND ALL PROJECT FILES ARE READY!
echo =====================================================================
echo.
echo You can now start the application:
echo   - Double click: run_project.bat
echo.
pause


